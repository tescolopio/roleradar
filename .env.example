# RoleRadar Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================
# API KEYS (Required for full functionality)
# ============================================================
# Get your Tavily API key from: https://tavily.com
TAVILY_API_KEY=
BRAVE_SEARCH_API=
# Get your Groq API key from: https://console.groq.com
GROQ_API_KEY=

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://username:password@host:5432/roleradar

# For SQLite (default, good for development/testing):
DATABASE_URL=sqlite:///roleradar.db

# SQLite fallback path when PostgreSQL is unavailable
SQLITE_FALLBACK_URL=sqlite:///roleradar.db

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# Timezone for scheduled searches (IANA format)
TIMEZONE=America/New_York

# Flask configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Enable web mode (suppresses password prompts in containers)
ROLERADAR_WEB_MODE=1

# ============================================================
# PERFORMANCE TUNING
# ============================================================
# Number of search results to process per batch
PROCESS_BATCH_SIZE=20

# Maximum characters to send to Groq AI (prevents context overflow)
GROQ_MAX_INPUT_CHARS=4000

# ============================================================
# DOCKER CONFIGURATION
# ============================================================
# External port for web service (maps to internal port 8000)
HOST_PORT=9000

# ============================================================
# SEARCH CONFIGURATION (Optional - can also configure via Admin UI)
# ============================================================
# Comma-separated list of job roles to search for (JSON format)
# SEARCH_ROLES=["security engineer","compliance officer","CISO"]

# Search schedule times in HH:MM format (JSON array, 24-hour)
# SCHEDULE_TIMES=["08:00","12:00","15:00"]

# ============================================================
# SCORING WEIGHTS (Optional - can also configure via Admin UI)
# ============================================================
# Adjust how opportunities are scored (must sum to 1.0)
# SCORING_WEIGHTS={"explicit_job_posting":0.4,"hiring_signals":0.3,"company_growth":0.2,"recent_activity":0.1}

# ============================================================
# PRODUCTION SECURITY (Important!)
# ============================================================
# 1. Generate a strong FLASK_SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. Use environment-specific values (never commit real keys)
#
# 3. For PostgreSQL in production, use SSL:
#    DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
#
# 4. Consider using Docker secrets or a secrets manager
#
# Alternative: Use RoleRadar's secure config manager:
#    python secure_config_manager.py init
#    python secure_config_manager.py migrate
#   python secure_config_manager.py set-key TAVILY_API_KEY
#   python secure_config_manager.py set-roles "role1, role2, role3"
#
